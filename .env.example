# Copy to .env.local and fill in. The server refuses to start if any of these are missing.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nextjs-fullstack?retryWrites=true&w=majority

# At least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Cloudinary Console → Dashboard → API Keys. Uploads go to folder products/<userId>.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public canonical origin. Set this to https://chaoscloset.vercel.app in Vercel Production.
# Preview deployments use their preview host and are marked noindex automatically.
NEXT_PUBLIC_SITE_URL=https://chaoscloset.vercel.app

# Optional. Paste the HTML tag verification value issued by Google Search Console.
GOOGLE_SITE_VERIFICATION=
